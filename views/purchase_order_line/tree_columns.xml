<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!--
      purchase.order.line.tree: SOLO CAMPOS del módulo sid_purchase_extra_fields
      (evitamos x_* y campos "legacy" sustituidos por sid_* / nuevos campos).
    -->
    <record id="view_purchase_order_line_tree_columns_sid" model="ir.ui.view">
      <field name="name">OV - purchase.order.line.tree (sid fields)</field>
      <field name="model">purchase.order.line</field>
      <field name="inherit_id" ref="purchase.purchase_order_line_tree"/>
      <field name="priority">16000</field>
      <field name="arch" type="xml">

        <!-- Antes de la descripción -->
        <xpath expr="//field[@name='name']" position="before">
          <field name="sid_hs_code_po_line" optional="show"/>
          <field name="supplier_country" optional="show"/>
          <field name="pending_line" optional="show"/>
          <field name="sid_invoice" optional="show"/>
          <field name="sid_po_line_delay" optional="show"/>
        </xpath>

        <!-- Fecha venta (propia) junto a contractual -->
        <xpath expr="//field[@name='contract_date']" position="after">
          <field name="sid_sale_date" optional="show" widget="date"/>
        </xpath>

        <!-- Facturación desde venta (propio) -->
        <xpath expr="//field[@name='product_qty']" position="after">
          <field name="sid_qty_inv_sale" optional="show"/>
        </xpath>

        <!-- Peso / diferencias (propios) -->
        <xpath expr="//field[@name='price_subtotal']" position="after">
          <field name="sid_unit_price_difference" optional="hide"/>
          <field name="sid_unit_weight_po_line" optional="show"/>
          <field name="sid_weight_subtotal" optional="show"/>
        </xpath>

      </field>
    </record>

  </data>
</odoo>
