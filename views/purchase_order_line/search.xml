<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- purchase.order.line.search: SOLO campos sid_purchase_extra_fields -->
    <record id="view_purchase_order_line_search_sid" model="ir.ui.view">
      <field name="name">OV - purchase.order.line.search (sid fields)</field>
      <field name="model">purchase.order.line</field>
      <field name="inherit_id" ref="purchase.purchase_order_line_search"/>
      <field name="priority">16000</field>
      <field name="arch" type="xml">

        <xpath expr="//filter[@name='hide_cancelled']" position="after">
          <filter name="sid_pending" string="Pendiente" domain="[('pending_line','=','true')]"/>
          <filter name="sid_invoice_facturar" string="Para facturar" domain="[('sid_invoice','=','facturar')]"/>
          <filter name="sid_invoice_pendiente" string="Pendiente facturación" domain="[('sid_invoice','=','pendiente')]"/>
        </xpath>

        <search>
          <searchpanel>
            <field name="sid_invoice" enable_counters="1" select="multi"/>
            <field name="pending_line" string="Pendiente" enable_counters="1" select="multi"/>
            <field name="supplier_country" string="País Origen" enable_counters="1" select="multi"/>
          </searchpanel>
        </search>

      </field>
    </record>

  </data>
</odoo>
