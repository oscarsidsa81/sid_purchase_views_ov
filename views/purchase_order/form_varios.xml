<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- purchase.order.form: SOLO campos propios (sid_purchase_extra_fields) -->
    <record id="view_purchase_order_form_custom_fields" model="ir.ui.view">
      <field name="name">OV - purchase.order.form (custom fields)</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form"/>
      <field name="priority">1600</field>
      <field name="arch" type="xml">

        <!-- Campo propio -->
        <xpath expr="//field[@name='picking_type_id']" position="after">
          <field name="sid_regularizado"/>
        </xpath>

        <!-- Botón estadístico que muestra un campo propio (si ya lo tenéis en vuestra UI) -->
        <xpath expr="//div[@name='button_box']/button[@name='action_view_picking']" position="after">
          <button class="oe_stat_button" icon="fa-sitemap" type="action" name="1265">
            <field widget="statinfo" name="sid_order_id_purchase_order_line_count" string="Líneas de pedido"/>
          </button>
        </xpath>

      </field>
    </record>

  </data>
</odoo>
