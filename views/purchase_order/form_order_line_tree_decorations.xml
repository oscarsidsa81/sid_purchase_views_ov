<odoo>
  <data>

    <record id="view_purchase_order_form_orderline_delay_deco" model="ir.ui.view">
      <field name="name">OV - PO form order_line delay decoration</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form"/>
      <field name="priority">16020</field>
      <field name="arch" type="xml">

        <!-- Aplica al tree de order_line embebido en el form -->
        <xpath expr="//page[@name='products']/field[@name='order_line']/tree" position="attributes">
          <attribute name="class">decorated-po-lines</attribute>
          <attribute name="decoration-muted">sid_po_line_delay in ('1_week_del','2_week_del','4_week_del','more_del')</attribute>
        </xpath>

        <!-- (Opcional) Asegurar que el campo está presente en el tree embebido -->
        <xpath expr="//page[@name='products']/field[@name='order_line']/tree/field[@name='name']" position="before">
          <field name="sid_po_line_delay" optional="show"/>
        </xpath>

      </field>
    </record>

  </data>
</odoo>
