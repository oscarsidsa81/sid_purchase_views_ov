<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_purchase_order_form_docs_domain" model="ir.ui.view">
            <field name="name">OV - purchase.order.form (domain + documentos)</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="priority">16</field>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_view_sale_orders']" position="attributes">
                    <attribute name="attrs">{'invisible': [('id', '=', False)]}</attribute>
                    <attribute name="groups">sales_team.group_sale_salesman,purchase.group_purchase_manager</attribute>
                </xpath>
                <xpath expr="//div[@name='button_box']/button[@name='action_view_picking']" position="after">
                    <button class="oe_stat_button"
                            icon="fa-sitemap"
                            type="action"
                            name="%(sid_purchase_views_ov.action_purchase_order_lines_from_po)d">
                        <field name="sid_order_id_purchase_order_line_count" widget="statinfo" string="Líneas de compra"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
