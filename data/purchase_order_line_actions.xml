<odoo>
  <data>

    <!-- Acción estable: líneas del pedido (purchase.order.line) filtradas por order_id = active_id -->
    <record id="action_purchase_order_lines_from_po" model="ir.actions.act_window">
      <field name="name">Líneas de pedido</field>
      <field name="res_model">purchase.order.line</field>
      <field name="view_mode">tree,form</field>
      <field name="domain">[('order_id', '=', active_id)]</field>
      <field name="context">{'search_default_order_id': active_id, 'default_order_id': active_id}</field>
      <field name="limit">150</field>
      <field name="target">current</field>
    </record>

  </data>
</odoo>
